# Необязательные значения для Docker Compose. Без .env используются те же значения.
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
POSTGRES_PORT=5432
APP_PORT=8000

# Для запуска Python или Alembic на хосте; контейнер получает URL из POSTGRES_*.
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5432/tutor
