# Необязательные значения для Docker Compose. Без .env используются те же значения.
APP_ENV=development
PORT=8000

POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
POSTGRES_PORT=5432

# Строка подключения внутри Docker Compose.
DATABASE_URL=postgresql+psycopg://tutor:tutor@db:5432/tutor
